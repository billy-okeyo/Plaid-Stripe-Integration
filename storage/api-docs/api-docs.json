        "/api/plaid/create-ach-transfer": {
            "post": {
                "tags": [
                    "ACH Transfer"
                ],
                "summary": "Create real ACH transfer using Plaid Processor + Stripe integration with fallback",
                "description": "Returns real ACH transfer using Plaid Processor + Stripe integration with fallback",
                "operationId": "dac46e19cb55bf03a8520da5cde6cb43",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "from_account_id": {
                                        "type": "integer"
                                    },
                                    "to_account_id": {
                                        "type": "integer"
                                    },
                                    "amount": {
                                        "type": "number"
                                    },
                                    "description": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "successful operation"
                    }
                }
            }
        },

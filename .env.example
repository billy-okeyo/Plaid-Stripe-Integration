APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dashboard Master API Token (never expires, all scopes)
DASHBOARD_API_TOKEN=your_dashboard_api_token_here

# Production/Sandbox Toggle
USE_PRODUCTION_APIS=false

# Plaid Configuration - Sandbox
PLAID_CLIENT_ID=your_plaid_sandbox_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_URL="https://sandbox.plaid.com"
PLAID_ENV=sandbox
PLAID_SANDBOX_PRODUCTS="auth,transactions"

# Plaid Configuration - Production
PLAID_PROD_CLIENT_ID=your_plaid_production_client_id
PLAID_PROD_SECRET=your_plaid_production_secret
PLAID_PROD_URL="https://production.plaid.com"
PLAID_PROD_ENV=production
PLAID_PROD_PRODUCTS="auth"

# Stripe Configuration - Test/Sandbox
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key

# Stripe Configuration - Production
STRIPE_PROD_SECRET_KEY=sk_live_your_stripe_production_secret_key
STRIPE_PROD_PUBLISHABLE_KEY=pk_live_your_stripe_production_publishable_key

# Legacy settings (kept for compatibility)
# STRIPE_CONNECT_ACCOUNT_ID=acct_your_stripe_connect_account_id
STRIPE_ENVIRONMENT=production

# Enable Financial Connections (instant verification via bank login)
STRIPE_FINANCIAL_CONNECTIONS_ENABLED=true

# Verification priority: 'instant' prioritizes bank login, 'microdeposit' prioritizes manual entry
STRIPE_VERIFICATION_PRIORITY=instant

# Force Financial Connections: if true, customers must use bank login (no manual entry option)
STRIPE_REQUIRE_FINANCIAL_CONNECTIONS=false

# Disable fallback to microdeposits - use direct routing/account numbers instead
STRIPE_FALLBACK_TO_MICRODEPOSITS=false

# Force instant verification methods only
STRIPE_FORCE_INSTANT_VERIFICATION=true

# Payment method preference: 'payment_intents' (modern) or 'charges' (legacy)
STRIPE_ACH_PAYMENT_METHOD=payment_intents

# Enable instant verification (tries Plaid tokens first, then falls back)
STRIPE_INSTANT_VERIFICATION=true

# Test Credentials for Sandbox Mode (used when USE_PRODUCTION_APIS=false)
TEST_ACCOUNT_NUMBER=000123456789
TEST_ROUTING_NUMBER=110000000
